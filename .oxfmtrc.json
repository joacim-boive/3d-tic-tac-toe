{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "out/**",
    "coverage/**",
    "next-env.d.ts",
    "package-lock.json"
  ]
}
