{
  "name": "3d-tic-tac-toe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:write": "oxfmt",
    "typecheck": "tsgo --noEmit",
    "check": "tsgo --noEmit && oxlint && oxfmt --check",
    "check:win": "npx tsx src/game/winCheck.selftest.ts",
    "check:pick": "npx tsx src/scene/pickCellAlongRay.selftest.ts",
    "check:ai": "npx tsx src/game/ai.selftest.ts",
    "check:room": "npx tsx src/game/roomCode.selftest.ts",
    "check:notify": "npx tsx src/online/notify.selftest.ts",
    "check:drop": "npx tsx src/game/drop.selftest.ts",
    "check:selfplay": "npx tsx src/game/selfPlay.selftest.ts",
    "eval:selfplay": "npx tsx src/game/selfPlay.cli.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/rapier": "^2.2.0",
    "next": "^15.5.4",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
